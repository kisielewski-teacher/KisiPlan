<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background">

    <!-- Accent bar, rounded to match the card's left edge. Plain <View> is
         rejected by RemoteViews ("Class not allowed to be inflated"), so
         this uses FrameLayout, which is on RemoteViews' supported list. -->
    <FrameLayout
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_accent_bar" />

    <!-- Content column: each row gets a weighted share of the full widget
         height (instead of wrap_content + centering) so autosize below has
         real room to grow into — teachers read this from arm's length, so
         text should scale up to fill the widget, not just sit at a fixed
         size with blank space around it. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:text="Plan Mechanika"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="17sp"
            android:textColor="@color/widget_accent" />

        <TextView
            android:id="@+id/widget_subject"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:gravity="center_vertical"
            android:text="Brak lekcji"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/widget_subject"
            android:maxLines="2"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="34sp" />

        <!-- Time, room and class each get their own row (instead of one
             joined line) so all three stay readable at a glance. Provider
             collapses whichever of these are empty (e.g. no room for a
             duty, no class for "Brak lekcji"), and LinearLayout hands a
             collapsed row's weight to the rows still visible. -->
        <TextView
            android:id="@+id/widget_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/widget_details"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp" />

        <TextView
            android:id="@+id/widget_room"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/widget_details"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp" />

        <TextView
            android:id="@+id/widget_class"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/widget_details"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp" />

    </LinearLayout>

</LinearLayout>
